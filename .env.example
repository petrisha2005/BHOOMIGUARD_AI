# Local application configuration. Copy to .env and provide real values locally;
# do not commit the resulting .env file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=replace-with-a-unique-local-secret
AUTH_REQUIRED=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set only for the one development-account provisioning command; do not use in production.
BHOOMIGUARD_ALLOW_DEVELOPMENT_SEED=false
